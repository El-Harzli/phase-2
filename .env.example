VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# variants (default) | transform | off
VITE_SUPABASE_IMAGE_MODE=variants

# Full address of the live site, no trailing slash (e.g. https://example.com) — used by the
# Netlify edge function property-og-tags.js for its fallback preview image. The sitemap
# (netlify/edge-functions/sitemap.js) doesn't need it: it uses the address it is requested on.
# Leave empty until the domain is live.
VITE_SITE_URL=