# Netlify custom headers (this file is copied to the site's root on every build).
#
# Everything the build puts under /assets/ — scripts, styles, fonts, images — has a
# hash of its content in its file name, so a changed file always gets a new address
# and an unchanged one never needs to be asked for again: browsers may keep them for
# a year. Without this, Netlify tells the browser to re-check each of them on every
# visit. index.html itself is not under /assets/, so it is still re-checked every time
# and always points at the current files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
